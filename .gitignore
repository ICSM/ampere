### A generic .gitignore file for python from github.com/github/gitignore, licensed under the MIT license.

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Text-editor backups
*[~#]

# C extensions
*.so

# Distribution / packaging
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg
pyphot-master/

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*,cover
.hypothesis/
.pytest_cache/
.ruff_cache/

# Translations
*.mo
*.pot

# Django stuff:
#*.log

# Tensorboard outputs
*.tfevents.*

# Sphinx documentation
docs/_build/

# PyBuilder
target/

#Mac files
.DS_Store

#Output files
*.png
irs-0.txt
irs-1.txt
irs-last.txt
*.pkl
ampere*.log

# Machine-learning run outputs (PyTorch Lightning, checkpoints)
lightning_logs/
*.ckpt

# Locally downloaded installer at the repository root
/miniforge.sh

# pixi (W0.8): per-machine installed environments; pixi.lock is committed,
# this is not.
.pixi/

# Example run output directories (pickles and figure PDFs/PNGs); the
# corresponding *.py scripts remain visible as untracked
examples/examples_paper/flexible_likelihood_comparison/
examples/examples_paper/flexible_likelihood_comparison_v0/

#Ciska's personal directories
notes/
old/
*.tar.gz
*.0
*.hdf5
*.fits
ampere/utils/ALMA/ALMA.B1.csv
ampere/utils/ALMA/ALMA.B10.csv
ampere/utils/ALMA/ALMA.B3.csv
ampere/utils/ALMA/ALMA.B4.csv
ampere/utils/ALMA/ALMA.B5.csv
ampere/utils/ALMA/ALMA.B6.csv
ampere/utils/ALMA/ALMA.B7.csv
ampere/utils/ALMA/ALMA.B8.csv
ampere/utils/ALMA/ALMA.B9.csv
